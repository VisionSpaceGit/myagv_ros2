<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="myagv">

  <!-- Arguments -->
  <xacro:arg name="ros2_control_config" default=""/>

  <!-- Dimensions (approximate, tune with measured data when available) -->
  <xacro:property name="base_length" value="0.31115"/>
  <xacro:property name="base_width" value="0.23"/>
  <xacro:property name="base_height" value="0.11"/>
  <xacro:property name="base_mass" value="4.16"/>

  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="wheel_width" value="0.032"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="wheel_offset_x" value="0.10555"/>
  <xacro:property name="wheel_offset_y" value="0.10525"/>

  <xacro:property name="imu_height" value="${base_height}"/>
  <xacro:property name="lidar_height" value="${wheel_radius + base_height}"/>
  <xacro:property name="camera_height" value="${base_height / 2}"/>

  <xacro:property name="mesh_path" value="$(find myagv_description)/meshes"/>
  <xacro:property name="ros2_control_config_path" value="$(arg ros2_control_config)"/>

  <!-- Helper macros -->
  <xacro:macro name="box_inertial" params="mass size_x size_y size_z origin_xyz">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="${origin_xyz}" rpy="0 0 0"/>
      <inertia
        ixx="${mass/12.0 * (size_y*size_y + size_z*size_z)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass/12.0 * (size_x*size_x + size_z*size_z)}"
        iyz="0.0"
        izz="${mass/12.0 * (size_x*size_x + size_y*size_y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length origin_xyz origin_rpy">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <inertia
        ixx="${mass/12.0 * (3*radius*radius + length*length)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass/2.0 * radius*radius}"
        iyz="0.0"
        izz="${mass/12.0 * (3*radius*radius + length*length)}"/>
    </inertial>
  </xacro:macro>

  <!-- Frames -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- <origin xyz="0 0.0045 0" rpy="0 0 0"/> -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Base link with visuals and collision -->
  <link name="base_link">
    <xacro:box_inertial mass="${base_mass}"
                        size_x="${base_length}"
                        size_y="${base_width}"
                        size_z="${base_height}"
                        origin_xyz="0 0 ${wheel_radius + base_height/2.0}"/>

    <visual>
      <origin xyz="-0.0055 0.0045 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://${mesh_path}/myagv_base.dae" scale="1 1 1"/>
      </geometry>
      <material name="black">
          <color rgba="0.7 0.7 0.0 1.0"/>
      </material>
    </visual>

    <visual>
      <origin xyz="-0.0055 0.0045 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://${mesh_path}/myagv_up.dae" scale="1 1 1"/>
      </geometry>
      <material name="black">
          <color rgba="0.7 0.7 0.0 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="-0.0055 0.0045 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://${mesh_path}/myagv_base.dae" scale="1 1 1"/>
      </geometry>
      <surface>
        <contact>
          <ode/>
        </contact>
        <friction>
          <ode mu="1.0" mu2="1.0"/>
        </friction>
      </surface>
    </collision>

    <collision>
      <origin xyz="-0.0055 0.0045 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://${mesh_path}/myagv_up.dae" scale="1 1 1"/>
      </geometry>
      <surface>
        <contact>
          <ode/>
        </contact>
        <friction>
          <ode mu="1.0" mu2="1.0"/>
        </friction>
      </surface>
    </collision>
  </link>

  <!-- Wheel macro -->
  <xacro:macro name="wheel_link" params="name parent xyz">
    <link name="${name}">
      <xacro:cylinder_inertial mass="${wheel_mass}"
                               radius="${wheel_radius}"
                               length="${wheel_width}"
                               origin_xyz="0 0 0"
                               origin_rpy="0 0 0"/>
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="${name}_dark_gray">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode mu="1.2" mu2="1.2"/>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20" velocity="25"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>
  </xacro:macro>

  <!-- Wheels -->
  <xacro:wheel_link name="front_left_wheel" parent="base_link"
                    xyz="${wheel_offset_x} ${wheel_offset_y} ${wheel_radius}"/>
  <xacro:wheel_link name="front_right_wheel" parent="base_link"
                    xyz="${wheel_offset_x} ${-wheel_offset_y} ${wheel_radius}"/>
  <xacro:wheel_link name="rear_left_wheel" parent="base_link"
                    xyz="${-wheel_offset_x} ${wheel_offset_y} ${wheel_radius}"/>
  <xacro:wheel_link name="rear_right_wheel" parent="base_link"
                    xyz="${-wheel_offset_x} ${-wheel_offset_y} ${wheel_radius}"/>

  <!-- Sensor frames -->
  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link"/>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.069 0 0.105" rpy="0 0 0"/>
  </joint>

  <link name="camera_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.125 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- ros2_control hardware interface for wheels -->
  <ros2_control name="myagv_system" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ros2_control plugin -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>${ros2_control_config_path}</parameters>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros_p3d" filename="libgazebo_ros_p3d.so">
      <update_rate>50.0</update_rate>

      <body_name>base_link</body_name>
      
      <frame_name>odom</frame_name>
      <child_frame_name>base_link</child_frame_name>
      
      <publish_tf>true</publish_tf>
      <gaussian_noise>0.0001</gaussian_noise>

      <ros>
        <remapping>~/odom:=/odom</remapping>
      </ros>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor type="imu" name="myagv_imu">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
      
      <imu>
        <topic>/imu/data</topic>
        <gaussian_noise>0.0001</gaussian_noise>
      </imu>

      <plugin name="gazebo_ros_imu_sensor" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/imu</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor type="ray" name="myagv_lidar">
      <always_on>true</always_on>
      <pose>0 0 0 0 0 0</pose>
      <update_rate>7.0</update_rate>
      <visualize>true</visualize>

      <ray>
        <scan>
          <horizontal>
            <samples>432</samples>
            <resolution>1</resolution>
            <min_angle>-3.1415926535</min_angle>
            <max_angle> 3.1415926535</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>

      <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>


  <gazebo reference="camera_link">
    <sensor type="camera" name="myagv_camera">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>

      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so"/>
    </sensor>
  </gazebo>

</robot>
